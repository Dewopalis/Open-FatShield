#!/usr/bin/env python3
from pathlib import Path
import sys

prefix = Path(__file__).resolve().parents[1]
for candidate in (prefix, prefix / "lib/open-fatshield", Path("/usr/lib/open-fatshield")):
    if (candidate / "open_fatshield").is_dir():
        sys.path.insert(0, str(candidate))
        break

from open_fatshield.cli import main
raise SystemExit(main())
