[Unit]
Description=Open FatShield wireless controller
After=NetworkManager.service
Requires=NetworkManager.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/open-fatshield daemon
ExecStopPost=/usr/bin/open-fatshield cleanup
Restart=on-failure
RestartSec=5
TimeoutStopSec=75
KillMode=mixed
RuntimeDirectory=open-fatshield
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=open-fatshield
StateDirectoryMode=0700
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
